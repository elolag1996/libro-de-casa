# Copia este archivo como .env.local y pega ahí los valores de tu proyecto.
# .env.local NUNCA se sube al repositorio.

# Supabase (Project Settings → API). Públicas a propósito: viajan al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groq (console.groq.com → API Keys). SECRETA: sin NEXT_PUBLIC_, solo se usa
# desde el servidor. Si acaba en el navegador, la gasta cualquiera.
GROQ_API_KEY=
# Opcional. Si se deja vacío, se usa openai/gpt-oss-120b.
GROQ_MODEL=
